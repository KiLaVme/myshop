# Скопіюйте цей файл у .env та відредагуйте значення під себе

# Django
DEBUG=1
SECRET_KEY=django-insecure-change-this-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=hopbarley
DB_USER=hopbarley_user
DB_PASSWORD=hopbarley_pass
DB_HOST=db
DB_PORT=5432

# Зовнішні порти (docker-compose.yml) - на яких портах хоста
# сервіси будуть доступні ззовні контейнерів
DB_EXTERNAL_PORT=5432
WEB_EXTERNAL_PORT=8000
SERVER_PORT=8000

# Email (у режимі розробки використовується console backend,
# для реального надсилання - вкажіть SMTP дані, наприклад Gmail/Mailtrap)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hopandbarley.local
ADMIN_EMAIL=admin@hopandbarley.local

# JWT
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
